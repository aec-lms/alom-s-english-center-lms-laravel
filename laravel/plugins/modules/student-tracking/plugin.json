{
  "slug": "student-tracking",
  "name": "Student Tracking & Analytics",
  "version": "1.0.0",
  "author": "Alom's English Center",
  "category": "academic",
  "description": "Independent, privacy-conscious student learning activity timeline, engagement analytics, progress signals and self-service activity history.",
  "core_compatibility": "^2.0",
  "dependencies": [],
  "optional_dependencies": [],
  "provider": "Plugins\\Modules\\StudentTracking\\Providers\\StudentTrackingServiceProvider",
  "permissions": [
    {"slug": "student-tracking.view", "name": "View Student Tracking Reports"},
    {"slug": "student-tracking.record", "name": "Record Learning Activity Events"}
  ],
  "settings_schema": [
    {"key": "retention_days", "label": "Activity retention (days)", "type": "number", "default": 365, "min": 30, "max": 1095}
  ]
}

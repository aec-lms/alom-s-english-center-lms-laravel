{
    "slug": "gateway-sslcommerz",
    "name": "SSLCOMMERZ Hosted Checkout Gateway",
    "version": "2.0.1",
    "author": "Alom's English Center",
    "category": "payment-gateway",
    "description": "Dedicated SSLCOMMERZ Hosted Checkout plugin with server-side session creation, Order Validation API verification, amount and currency matching, and risk review handling.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\GatewaySslcommerz\\Providers\\GatewaySslcommerzServiceProvider",
    "permissions": [
        {
            "slug": "gateway.sslcommerz.use",
            "name": "Initiate SSLCOMMERZ Hosted Checkout"
        }
    ],
    "settings_schema": [
        {
            "key": "store_id",
            "label": "SSLCOMMERZ Store ID",
            "type": "text",
            "secret": true
        },
        {
            "key": "store_password",
            "label": "SSLCOMMERZ Store Password",
            "type": "password",
            "secret": true
        },
        {
            "key": "sandbox_mode",
            "label": "Sandbox Mode (1/0)",
            "type": "text",
            "secret": false
        }
    ]
}

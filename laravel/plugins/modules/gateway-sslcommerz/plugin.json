{
    "slug": "gateway-sslcommerz",
    "name": "SSLCOMMERZ Hosted Checkout Gateway",
    "version": "2.0.2",
    "author": "Alom's English Center",
    "category": "payment-gateway",
    "description": "Dedicated SSLCOMMERZ Hosted Checkout with Session API, Order Validation API, amount/currency matching, risk review and encrypted Store credentials.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\GatewaySslcommerz\\Providers\\GatewaySslcommerzServiceProvider",
    "permissions": [
        {
            "slug": "gateway.sslcommerz.use",
            "name": "Initiate SSLCOMMERZ Hosted Checkout"
        }
    ],
    "settings_schema": [
        {
            "key": "store_id",
            "label": "SSLCOMMERZ Store ID",
            "type": "text",
            "secret": true
        },
        {
            "key": "store_password",
            "label": "SSLCOMMERZ Store Password",
            "type": "password",
            "secret": true
        },
        {
            "key": "sandbox_mode",
            "label": "SSLCOMMERZ Environment",
            "type": "select",
            "secret": false,
            "default": "1",
            "options": {
                "0": "Live",
                "1": "Sandbox"
            }
        }
    ],
    "optional_dependencies": [
        "fees-management",
        "payment-management",
        "student-management",
        "universal-payment"
    ]
}

{
    "slug": "library-management",
    "name": "Library Management",
    "version": "2.0.0",
    "author": "Alom's English Center",
    "category": "academic",
    "description": "Printed Book Inventory, ISBN Catalog, Issue/Return Tracking, and Late-Return Fine Calculation.",
    "core_compatibility": "^2.0",
    "dependencies": [
        "branch-management"
    ],
    "provider": "Plugins\\Modules\\LibraryManagement\\Providers\\LibraryManagementServiceProvider",
    "permissions": [
        {
            "slug": "library.manage",
            "name": "Manage Library Catalog & Book Loans"
        }
    ],
    "settings_schema": [
        {
            "key": "daily_fine_bdt",
            "label": "Overdue Fine per Day (BDT)",
            "encrypted": false
        },
        {
            "key": "default_loan_days",
            "label": "Default Loan Duration (Days)",
            "encrypted": false
        }
    ],
    "admin_menu": [
        {
            "group": "Academic & Operations",
            "label": "Library & Loans",
            "route": "plugins.library.index",
            "order": 100,
            "permission": "library.manage"
        }
    ]
}

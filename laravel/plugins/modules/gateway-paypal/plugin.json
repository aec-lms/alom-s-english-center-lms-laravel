{
    "slug": "gateway-paypal",
    "name": "PayPal Payment Gateway",
    "version": "2.0.1",
    "author": "Alom's English Center",
    "category": "payment-gateway",
    "description": "Live PayPal Orders v2 checkout and capture with OAuth credentials, server-side webhook signature verification, amount/currency matching and idempotency.",
    "core_compatibility": "^2.0",
    "dependencies": [
        "payment-management"
    ],
    "provider": "Plugins\\Modules\\GatewayPaypal\\Providers\\GatewayPaypalServiceProvider",
    "permissions": [
        {
            "slug": "payments.paypal.manage",
            "name": "Manage PayPal Orders & Webhooks"
        }
    ],
    "settings_schema": [
        {
            "key": "client_id",
            "label": "PayPal REST App Client ID",
            "type": "text",
            "secret": false,
            "help": "Create a REST API app in PayPal Developer Dashboard."
        },
        {
            "key": "client_secret",
            "label": "PayPal REST App Secret",
            "type": "password",
            "secret": true
        },
        {
            "key": "webhook_id",
            "label": "PayPal Webhook ID",
            "type": "password",
            "secret": true,
            "help": "Webhook ID from the PayPal Developer Dashboard; the server verifies each event with PayPal."
        },
        {
            "key": "sandbox_mode",
            "label": "PayPal Environment",
            "type": "select",
            "secret": false,
            "default": "1",
            "options": {
                "0": "Live",
                "1": "Sandbox"
            }
        }
    ],
    "admin_menu": [
        {
            "group": "Finance & Gateways",
            "label": "PayPal Gateway",
            "route": "plugins.gateway_paypal.index",
            "order": 100
        }
    ]
}

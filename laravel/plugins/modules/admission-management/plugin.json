{
    "slug": "admission-management",
    "name": "Admission Management",
    "version": "2.2.0",
    "author": "Alom's English Center",
    "category": "academic",
    "description": "Advanced admission pipeline with branch-aware screening, interview scheduling, reviewer assignment, private document evidence, secure applicant tracking, optional admission-fee invoicing, and idempotent student conversion.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\AdmissionManagement\\Providers\\AdmissionManagementServiceProvider",
    "permissions": [
        {
            "slug": "admissions.manage",
            "name": "Review & Approve Admission Applications"
        }
    ],
    "settings_schema": [
        {
            "key": "intake_status",
            "label": "Admission Intake Status (open/closed)",
            "encrypted": false
        },
        {
            "key": "admission_fee_bdt",
            "label": "Default Admission Processing Fee (BDT)",
            "encrypted": false
        }
    ],
    "admin_menu": [
        {
            "group": "Academic & Operations",
            "label": "Admissions",
            "route": "plugins.admissions.index",
            "order": 100,
            "permission": "admissions.manage"
        }
    ],
    "optional_dependencies": [
        "branch-management",
        "student-management",
        "fees-management"
    ]
}

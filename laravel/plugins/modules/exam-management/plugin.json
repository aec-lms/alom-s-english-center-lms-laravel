{
    "slug": "exam-management",
    "name": "Exam Management & Online Assessment Engine",
    "version": "2.1.0",
    "author": "Alom's English Center",
    "category": "academic",
    "description": "Exam schedules, exam-specific questions, online exam attempts with strict server-side grading, and results. Reusable BCS, Bank Job and Admission question banks are provided by the standalone Question Bank plugin.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\ExamManagement\\Providers\\ExamManagementServiceProvider",
    "permissions": [
        {
            "slug": "exams.manage",
            "name": "Manage Exams & Online Assessments"
        },
        {
            "slug": "exams.attempt",
            "name": "Attempt Online Exams"
        }
    ],
    "settings_schema": [],
    "admin_menu": [
        {
            "group": "Academic & Operations",
            "label": "Exam Management",
            "route": "plugins.exams.index",
            "order": 100,
            "permission": "exams.manage"
        }
    ],
    "dashboard_widgets": [
        {
            "key": "exam-performance",
            "label": "Exam Performance",
            "view": "dashboard.exam-performance",
            "permission": "exams.manage",
            "default": false
        }
    ]
}

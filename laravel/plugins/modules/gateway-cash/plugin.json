{
    "slug": "gateway-cash",
    "name": "Cash Desk Payment",
    "version": "1.0.0",
    "author": "Alom's English Center",
    "category": "payment-gateway",
    "description": "Installable manual cash collection method with configurable receipt instructions and reviewer-controlled settlement through Universal Payment.",
    "core_compatibility": "^2.0",
    "dependencies": [
        "universal-payment"
    ],
    "provider": "Plugins\\Modules\\GatewayCash\\Providers\\GatewayCashServiceProvider",
    "permissions": [
        {
            "slug": "gateway.cash.submit",
            "name": "Record Cash Desk Payments"
        }
    ],
    "settings_schema": [
        {
            "key": "receipt_prefix",
            "label": "Cash Receipt Prefix",
            "type": "text",
            "secret": false
        },
        {
            "key": "instructions",
            "label": "Cash Payment Instructions",
            "type": "textarea",
            "secret": false
        }
    ],
    "optional_dependencies": [
        "payment-management"
    ]
}
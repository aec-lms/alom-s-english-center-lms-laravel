{
    "slug": "notification-center",
    "name": "Multi-Channel Notification Center",
    "version": "2.0.0",
    "author": "Alom's English Center",
    "category": "communication",
    "description": "In-app notification inbox and encrypted Email/SMS/Push gateway configuration.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\NotificationCenter\\Providers\\NotificationCenterServiceProvider",
    "permissions": [
        {
            "slug": "notifications.manage",
            "name": "Manage & Dispatch Notifications"
        }
    ],
    "settings_schema": [
        {
            "key": "sms_provider",
            "label": "SMS Provider (twilio/sslwireless)",
            "type": "text",
            "secret": false
        },
        {
            "key": "sms_api_token",
            "label": "SMS API Token",
            "type": "password",
            "secret": true
        },
        {
            "key": "push_server_key",
            "label": "Push Gateway Key",
            "type": "password",
            "secret": true
        }
    ]
}

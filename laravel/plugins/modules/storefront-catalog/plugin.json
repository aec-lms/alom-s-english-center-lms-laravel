{
  "slug": "storefront-catalog",
  "name": "Products & E-Books Storefront Plugin",
  "version": "1.0.0",
  "description": "Independent plugin to create, edit, upload thumbnails, publish, and delete Printed Products, Study Kits, and Free/Premium E-Books.",
  "author": "AEC LMS Core Team",
  "service_provider": "Plugins\\Modules\\StorefrontCatalog\\Providers\\StorefrontCatalogServiceProvider",
  "dependencies": [],
  "migrations_path": "Database/Migrations",
  "routes_file": "Routes/web.php",
  "permissions": [
    "cms.manage"
  ],
  "settings_schema": {
    "currency_symbol": {
      "type": "string",
      "label": "Currency Symbol",
      "encrypted": false,
      "required": false,
      "default": "৳"
    }
  }
}

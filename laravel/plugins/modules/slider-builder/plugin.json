{
    "slug": "slider-builder",
    "name": "Slider Builder",
    "version": "2.1.0",
    "author": "Alom's English Center",
    "category": "website",
    "description": "Advanced responsive slider and campaign builder with scheduling, CTA controls, transitions, and image uploads.",
    "core_compatibility": "^2.0",
    "dependencies": [
        "cms-website"
    ],
    "provider": "Plugins\\Modules\\SliderBuilder\\Providers\\SliderBuilderServiceProvider",
    "permissions": [
        {
            "slug": "slider_builder.manage",
            "name": "Manage Hero & Promotional Sliders"
        }
    ],
    "settings_schema": [
        {
            "key": "autoplay_ms",
            "label": "Default Slider Autoplay Interval (ms)",
            "type": "text",
            "secret": false
        },
        {
            "key": "pause_on_hover",
            "label": "Pause autoplay on hover",
            "type": "boolean",
            "secret": false
        }
    ],
    "admin_menu": [
        {
            "group": "CMS, Builders & AI",
            "label": "Slider Builder",
            "route": "plugins.slider_builder.index",
            "order": 100,
            "permission": "slider_builder.manage"
        }
    ]
}

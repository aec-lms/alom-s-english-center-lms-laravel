{
    "slug": "role-ai-assistant",
    "name": "AEC LMS AI Assistant",
    "version": "2.0.2",
    "author": "Alom's English Center",
    "category": "ai",
    "description": "AEC LMS role-based AI assistant with encrypted integration credentials, role allowlists, and privacy-aware audit logs.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\RoleAiAssistant\\Providers\\RoleAiAssistantServiceProvider",
    "permissions": [
        {
            "slug": "ai.assistant.use",
            "name": "Use AEC LMS AI Assistant"
        },
        {
            "slug": "ai.assistant.configure",
            "name": "Configure AEC LMS AI Assistant"
        }
    ],
    "settings_schema": [
        {
            "key": "provider",
            "label": "AI Integration Provider",
            "type": "select",
            "secret": false,
            "options": {
                "openai": "OpenAI API",
                "gemini": "Gemini API"
            }
        },
        {
            "key": "model",
            "label": "Model Identifier",
            "type": "text",
            "secret": false
        },
        {
            "key": "api_key",
            "label": "Integration API Key",
            "type": "password",
            "secret": true
        },
        {
            "key": "allowed_roles",
            "label": "Allowed LMS Roles (comma-separated)",
            "type": "text",
            "secret": false
        },
        {
            "key": "max_tokens",
            "label": "Maximum Output Tokens",
            "type": "text",
            "secret": false
        }
    ]
}

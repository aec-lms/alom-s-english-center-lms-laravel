{
    "slug": "cms-website",
    "name": "Website CMS & Blog",
    "version": "2.1.0",
    "author": "Alom's English Center",
    "category": "website",
    "description": "Blog and article publishing with revision history, scheduled publishing, safe recycle-bin recovery, homepage copy customization, and contact inquiry management (Page Builder, Slider Builder, and Carousel Builder are separate independent plugins).",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\CmsWebsite\\Providers\\CmsWebsiteServiceProvider",
    "permissions": [
        {
            "slug": "cms.manage",
            "name": "Manage Website CMS, Blog Posts & Contact Inquiries"
        }
    ],
    "settings_schema": [
        {
            "key": "site_brand_title",
            "label": "Website Brand Title",
            "type": "text",
            "secret": false
        },
        {
            "key": "site_contact_email",
            "label": "Public Contact Email",
            "type": "text",
            "secret": false
        }
    ],
    "admin_menu": [
        {
            "group": "CMS, Builders & AI",
            "label": "Website CMS",
            "route": "plugins.cms.index",
            "order": 100,
            "permission": "cms.manage"
        }
    ]
}

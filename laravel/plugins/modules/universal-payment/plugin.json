{
    "slug": "universal-payment",
    "name": "Universal Payment Gateway Plugin",
    "version": "2.4.0",
    "author": "AEC Core Team",
    "category": "finance",
    "description": "Payment Core and gateway-plugin registry for online checkout, hosted-provider callbacks, canonical invoice settlement, offline/manual receipts, bank transfers and card acquiring adapters. Provider credentials remain isolated in each gateway plugin; manual receipts require authorized review.",
    "core_compatibility": "^2.0",
    "dependencies": [],
    "provider": "Plugins\\Modules\\UniversalPayment\\Providers\\UniversalPaymentServiceProvider",
    "permissions": [
        {
            "slug": "payments.universal.manage",
            "name": "Manage Universal Payment Gateways & Transactions"
        }
    ],
    "settings_schema": [
        {
            "key": "default_currency",
            "label": "Default Currency (e.g. BDT)",
            "type": "text",
            "secret": false,
            "default": "BDT"
        },
        {
            "key": "enabled_gateways",
            "label": "Allowed installed gateway slugs (comma separated)",
            "type": "text",
            "secret": false,
            "help": "Only enabled, credential-configured gateway plugins can be offered. Provider secrets must be saved in each gateway plugin."
        },
        {
            "key": "allow_offline_payments",
            "label": "Allow Cash / Bank Transfer (1/0)",
            "type": "select",
            "secret": false,
            "default": "1",
            "options": {
                "0": "Disabled",
                "1": "Enabled"
            }
        }
    ],
    "admin_menu": [
        {
            "group": "Finance & Gateways",
            "label": "Universal Payment",
            "route": "plugins.universal_payment.index",
            "order": 100,
            "permission": "payments.universal.manage"
        }
    ],
    "optional_dependencies": [
        "fees-management",
        "gateway-paypal",
        "gateway-sslcommerz",
        "gateway-stripe",
        "payment-management",
        "referral-income",
        "marketing-management",
        "course-management",
        "gateway-bkash",
        "gateway-nagad",
        "gateway-rocket",
        "gateway-card",
        "gateway-cash",
        "gateway-bank-transfer"
    ]
}

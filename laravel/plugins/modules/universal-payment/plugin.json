{
    "slug": "universal-payment",
    "name": "Universal Payment Gateway Plugin",
    "version": "2.3.0",
    "author": "AEC Core Team",
    "category": "finance",
    "description": "Invoice-bound payment orchestration with independently configurable gateway adapters; offline records require audited manual verification.",
    "core_compatibility": "^2.0",
    "dependencies": [
        "payment-management",
        "fees-management"
    ],
    "provider": "Plugins\\Modules\\UniversalPayment\\Providers\\UniversalPaymentServiceProvider",
    "permissions": [
        {
            "slug": "payments.universal.manage",
            "name": "Manage Universal Payment Gateways & Transactions"
        }
    ],
    "settings_schema": [
        {
            "key": "default_currency",
            "label": "Default Currency (e.g. BDT)",
            "type": "text",
            "secret": false,
            "default": "BDT"
        },
        {
            "key": "enabled_gateways",
            "label": "Allowed installed gateway slugs (comma separated)",
            "type": "text",
            "secret": false,
            "help": "Only enabled, credential-configured gateway plugins can be offered. Provider secrets must be saved in each gateway plugin."
        },
        {
            "key": "allow_offline_payments",
            "label": "Allow Cash / Bank Transfer (1/0)",
            "type": "select",
            "secret": false,
            "default": "1",
            "options": {
                "0": "Disabled",
                "1": "Enabled"
            }
        }
    ]
}

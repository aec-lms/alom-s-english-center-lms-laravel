APP_NAME="AEC LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alomsenglishcenter.com
APP_VERSION=2.0.0

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@alomsenglishcenter.com"
MAIL_FROM_NAME="${APP_NAME}"

AEC_PLUGIN_SIGNING_KEY=
AEC_BACKUP_ENCRYPTION_KEY=
AEC_PRIVATE_STORAGE_PATH=storage/app/private

# Optional isolated MySQL database for destructive production backup restore rehearsals.
# Never point this at the live production database.
AEC_BACKUP_REHEARSAL_DB_HOST=127.0.0.1
AEC_BACKUP_REHEARSAL_DB_PORT=3306
AEC_BACKUP_REHEARSAL_DB_DATABASE=
AEC_BACKUP_REHEARSAL_DB_USERNAME=
AEC_BACKUP_REHEARSAL_DB_PASSWORD=
AEC_BACKUP_REHEARSAL_DB_SOCKET=

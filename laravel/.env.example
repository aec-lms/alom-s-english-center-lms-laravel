APP_NAME="AEC LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_VERSION=2.0.0

# Installation defaults. Use an IANA timezone, a supported Laravel locale,
# and a valid Faker locale. Tenant-aware runtime overrides are a later SaaS gate.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Dedicated origin for untrusted SCORM 1.2 package files (must differ from APP_URL).
# Use a host-only session cookie; never set SESSION_DOMAIN to the parent domain.
SCORM_CONTENT_ORIGIN=https://scorm-content.example.com
SCORM_LAUNCH_TTL_MINUTES=240

QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AEC_PLUGIN_SIGNING_KEY=
# JSON object mapping trusted release key IDs to base64 Ed25519 public keys.
# Example: {"release-2026":"BASE64_PUBLIC_KEY"}
LMS_PLUGIN_SIGNATURE_PUBLIC_KEYS='{}'
AEC_BACKUP_ENCRYPTION_KEY=
AEC_PRIVATE_STORAGE_PATH=storage/app/private

# Optional isolated MySQL database for destructive production backup restore rehearsals.
# Never point this at the live production database.
AEC_BACKUP_REHEARSAL_DB_HOST=127.0.0.1
AEC_BACKUP_REHEARSAL_DB_PORT=3306
AEC_BACKUP_REHEARSAL_DB_DATABASE=
AEC_BACKUP_REHEARSAL_DB_USERNAME=
AEC_BACKUP_REHEARSAL_DB_PASSWORD=
AEC_BACKUP_REHEARSAL_DB_SOCKET=

# Optional S3-compatible off-site storage for already-encrypted LMS backup archives.
AEC_BACKUP_S3_ENDPOINT=
AEC_BACKUP_S3_REGION=
AEC_BACKUP_S3_BUCKET=
AEC_BACKUP_S3_ACCESS_KEY=
AEC_BACKUP_S3_SECRET_KEY=
AEC_BACKUP_S3_PREFIX=aec-lms-backups
